{
  "name": "starlight-to-skills-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Turn Starlight documentation pages into reviewed, discoverable, and up-to-date agent skills.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "scripts": {
    "test": "pnpm --stream -r test",
    "lint": "astro check --noSync && pnpm -r lint",
    "format": "prettier -w --cache --ignore-unknown .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@hideoo/eslint-config": "^4.1.1",
    "@hideoo/prettier-config": "^2.0.1",
    "@hideoo/tsconfig": "^2.0.3",
    "astro": "^7.2.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.13.0",
  "private": true,
  "sideEffects": false,
  "keywords": [
    "starlight",
    "plugin",
    "skills",
    "ai",
    "agent",
    "documentation",
    "astro"
  ],
  "homepage": "https://github.com/HiDeoo/starlight-to-skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/starlight-to-skills.git"
  },
  "bugs": "https://github.com/HiDeoo/starlight-to-skills/issues"
}
