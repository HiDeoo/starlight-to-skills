{
  "name": "starlight-to-skills",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Turn Starlight documentation pages into reviewed, discoverable, and up-to-date agent skills.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "bin": "./dist/cli.mjs",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./components/SkillCallout.astro": "./dist/user-components/SkillCallout.astro",
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./routes/catalog": "./dist/routes/catalog.astro",
    "./routes/discovery": "./dist/routes/discovery.mjs",
    "./skill": {
      "types": "./dist/skill.d.mts",
      "import": "./dist/skill.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "lint": "eslint . --cache --max-warnings=0",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@mastra/core": "^1.50.0",
    "gray-matter": "^4.0.3",
    "jest-diff": "^30.4.1",
    "jiti": "^2.7.0",
    "package-manager-detector": "^1.8.0",
    "smol-toml": "^1.7.0",
    "tar-stream": "^3.2.0",
    "yocto-spinner": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/tar-stream": "^3.1.4",
    "tsdown": "^0.22.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.0",
    "astro": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "starlight",
    "plugin",
    "skills",
    "ai",
    "agent",
    "documentation",
    "astro"
  ],
  "homepage": "https://github.com/HiDeoo/starlight-to-skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/starlight-to-skills.git",
    "directory": "packages/starlight-to-skills"
  },
  "bugs": "https://github.com/HiDeoo/starlight-to-skills/issues"
}
