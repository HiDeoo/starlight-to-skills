---
import { Code, Icon } from '@astrojs/starlight/components'
import { AstroError } from 'astro/errors'
import skills from 'virtual:starlight-to-skills/skills'

export interface Props {
  skill: string
  title?: string
}

const { skill, title = Astro.locals.t('starlightToSkills.skillCallout.title') } = Astro.props

const site = Astro.site
if (!site) {
  throw new AstroError(
    "The `<SkillCallout>` component requires Astro's `site` option to be defined.",
    "Configure Astro's `site` option to use the `<SkillCallout>` component.",
  )
}

if (!skills.skills.some(({ name }) => name === skill)) {
  throw new AstroError(
    `No approved skill found for '${skill}'.`,
    'Check the skill name or approve the skill before using the `<SkillCallout>` component.',
  )
}

const command = `npx skills add ${site.origin} --skill ${skill}`
const hasFooter = Astro.slots.has('footer')
---

<aside aria-label={title} class="skill-callout">
  <div class="overview">
    <p aria-hidden="true" class="title">
      <Icon name="puzzle" size="1.25rem" />{title}
    </p>
    <div class="content">
      <slot />
    </div>
  </div>
  <div class="action">
    <p class="label">
      <span aria-hidden="true" class="marker"></span>{Astro.locals.t('starlightToSkills.skillCallout.install')}
    </p>
    <div class="command"><Code code={command} frame="none" lang="sh" /></div>
  </div>
  {
    hasFooter && (
      <div class="content footer">
        <slot name="footer" />
      </div>
    )
  }
</aside>

<style>
  .skill-callout {
    --skill-callout-padding: clamp(1rem, calc(0.5rem + 1.5vw), 1.25rem);

    border: 1px solid var(--sl-color-gray-5);
    margin-top: var(--sl-content-gap-y);
  }

  .overview {
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .overview,
  .footer {
    padding: var(--skill-callout-padding);
  }

  .title {
    align-items: flex-start;
    color: var(--sl-color-white);
    display: flex;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    gap: 0.5rem;
    line-height: 1.3;
  }

  .title :global(svg) {
    color: var(--sl-color-text-accent);
    flex: none;
  }

  .content {
    margin-top: 0.75rem;
  }

  .content:empty {
    margin-top: 0;
  }

  .content.footer {
    margin-top: 0;
  }

  .action {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 0;
  }

  .label {
    align-items: center;
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    display: flex;
    font-size: var(--sl-text-2xs);
    font-weight: 700;
    gap: 0.75rem;
    justify-content: flex-start;
    letter-spacing: 0.075em;
    padding-block: 0.625rem;
    padding-inline: var(--skill-callout-padding);
    text-transform: uppercase;
  }

  .marker {
    background-color: var(--sl-color-accent);
    block-size: 0.375rem;
    inline-size: 0.375rem;
  }

  .command {
    margin-top: 0;
  }

  .command :global(.expressive-code pre) {
    border-block: none;
    border-inline: none;
  }

  .footer {
    border-top: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 50rem) {
    .action {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .label {
      border-bottom: none;
      border-inline-end: 1px solid var(--sl-color-gray-5);
      justify-content: center;
      padding-block: 0;
      padding-inline: var(--skill-callout-padding);
    }

    .command :global(.expressive-code pre > code) {
      padding-bottom: 0;
    }
  }
</style>
